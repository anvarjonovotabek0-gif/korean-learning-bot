        if len(row) == 4:
            rows.append(row)
            row = []
    if row:
        rows.append(row)
    rows.append([InlineKeyboardButton(text="⬅️ Orqaga", callback_data="tests")])
    if call.message:
        await call.message.edit_text(
            f"📝 <b>{title}</b>\n\nTest raqamini tanlang 👇",
            reply_markup=InlineKeyboardMarkup(inline_keyboard=rows),
        )
    await call.answer()


@dp.callback_query(F.data.startswith("t:"))
async def send_test(call: CallbackQuery):
    _, level, num = call.data.split(":")
    title, _ = LEVELS[level]
    folder = TESTS_DIR / f"topik{level}"
    pdfs, audios = find_files(folder, num)

    if not pdfs and not audios:
        logging.warning("Fayl topilmadi: papka=%s raqam=%s", folder, num)
        await call.answer("Bu test tez orada joylanadi 🙏", show_alert=True)
        return

    await call.answer("Yuborilmoqda, biroz kuting...")
    try:
        if not call.message:
            return
        for pdf in pdfs:
            await call.message.answer_document(
                FSInputFile(pdf), caption=f"📝 <b>{title} — {num}-test</b>"
            )
        for audio in audios:
            cap = f"🎧 {title} — {num}-test audiosi"
            if audio.suffix.lower() in (".mp3", ".m4a"):
                await call.message.answer_audio(FSInputFile(audio), caption=cap)
            else:
                await call.message.answer_document(FSInputFile(audio), caption=cap)
    except Exception:
        logging.exception("Yuborishda xato")
        await call.message.answer(
            "⚠️ Fayl yuborilmadi. Fayl hajmi va hosting loglarini tekshiring."
        )


